<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/thu_vien"
    android:background="@color/mau_nen_anh_den"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/nut_bam_quay_lai"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/customhinhvuong"
        android:src="@drawable/ic_prev_back"
        android:scaleType="centerInside"
        android:contentDescription="@string/text_quay_lai"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/tieu_de_thu_vien"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/thu_vien"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintTop_toBottomOf="@+id/nut_bam_quay_lai"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:fontFamily="@font/lalezar"
        />
    <LinearLayout
        android:id="@+id/khung_doc_am_nhac_cho_ban"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tieu_de_thu_vien"
        >

        <include layout="@layout/activity_nghe_gan_day"/>
        <ListView
            android:id="@+id/listview_thuvien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tieu_de_thu_vien"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/khung_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <include android:id="@+id/id_menu_thuvien" layout="@layout/activity_menu"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>