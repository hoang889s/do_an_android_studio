<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="50dp"
    android:id="@+id/khung_bai_hat_ten_va_tim"
    android:background="@color/mau_nen_anh_den"
    >

    <TextView
        android:id="@+id/ten_tac_gia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="the Captain"
        android:textSize="14sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />
    <TextView
        android:id="@+id/ten_bai_hat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DANNY AVILA"
        android:textSize="16sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ten_tac_gia"

        />
    <ImageButton
        android:id="@+id/nut_tim_vien"
        android:layout_height="24dp"
        android:layout_width="24dp"
        android:src="@drawable/ic_icon_heart_outline"
        android:contentDescription="."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/mau_nen_anh_den"
        />

</androidx.constraintlayout.widget.ConstraintLayout>