<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bai_hat_yeu_thich"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mau_nen_anh_den"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/nut_bam_quay_lai"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_quay_lai"
        android:scaleType="centerInside"
        android:src="@drawable/ic_prev_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tieu_de_bai_hat_yeu_thich"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/lalezar"
        android:text="@string/text_bai_hat_yeu_thich"
        android:textColor="@color/mau_cam_thanh_tab"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nut_bam_quay_lai" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nut_bam_phat_ngau_nhien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/text_nut_phat_ngau_nhien"
        android:textAllCaps="false"
        app:icon="@drawable/ic_icon_random"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tieu_de_bai_hat_yeu_thich" />

    <TextView
        android:id="@+id/tieuu_de_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/text_playlist"
        android:textColor="@color/mau_cam_thanh_tab"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nut_bam_phat_ngau_nhien" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listview_baihatyeuthich"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/layout_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tieuu_de_playlist"
        tools:listitem="@layout/activity_item_baihatyeuthich" />

    <LinearLayout
        android:id="@+id/layout_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/mini_player_container"
            layout="@layout/mini_player"
            android:visibility="gone" />

        <include
            android:id="@+id/id_menu_baihatyeuthich"
            layout="@layout/activity_menu" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>