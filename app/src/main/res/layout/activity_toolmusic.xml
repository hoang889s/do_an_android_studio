<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:id="@+id/khung_tool_music"
    android:gravity="center"
    android:background="@color/mau_nen_anh_den"
    >
    <ImageButton
        android:id="@+id/nut_random"
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:src="@drawable/ic_icon_random"
        android:contentDescription="h"
        android:background="@color/mau_nen_anh_den"
        android:layout_weight="1"
        />
    <ImageButton
        android:id="@+id/nut_prev"
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:src="@drawable/ic_icon_prev"
        android:contentDescription="."
        android:background="@color/mau_nen_anh_den"
        android:layout_weight="1"
        />
    <ImageButton
        android:id="@+id/nut_pause"
        android:layout_height="58dp"
        android:layout_width="58dp"
        android:src="@drawable/ic_icon_pause"
        android:contentDescription="."
        android:background="@color/mau_nen_anh_den"
        android:layout_weight="1"
        />
    <ImageButton
        android:id="@+id/nut_next"
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:src="@drawable/ic_icon_next"
        android:contentDescription="."
        android:background="@color/mau_nen_anh_den"
        android:layout_weight="1"
        />
    <ImageButton
        android:id="@+id/nut_loop"
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:src="@drawable/ic_icon_loop"
        android:contentDescription="."
        android:background="@color/mau_nen_anh_den"
        android:layout_weight="1"
        />
</LinearLayout>