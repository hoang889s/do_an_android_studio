<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/layout_item_baihatyeuthich"
    android:background="@color/mau_nen_anh_den"
    android:layout_height="wrap_content">
    <LinearLayout
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/khung_playlist_ngang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/customkhungplaylist">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_song"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/imgsong1"
            android:background="@drawable/custombotronimg"
            android:clipToOutline="true"
            app:shapeAppearanceOverlay="@style/Botronanh"
            />
    </LinearLayout>
    <TextView
        android:id="@+id/name_song_baihatyeuthich"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:text="@string/bai_hat"
        app:layout_constraintStart_toEndOf="@id/khung_playlist_ngang"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="20dp"
        />
    <TextView
        android:id="@+id/name_tacgia_baihatyeuthich"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:text="@string/tac_gia"
        app:layout_constraintStart_toEndOf="@id/khung_playlist_ngang"
        app:layout_constraintTop_toBottomOf="@id/name_song_baihatyeuthich"
        android:layout_marginLeft="20dp"
        />
    <ImageButton
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:id="@+id/nut_bam_chitiet"
        android:src="@drawable/ic_three_dots"
        android:background="@color/mau_nen_anh_den"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <ImageButton
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:id="@+id/nut_bam_tim"
        android:src="@drawable/ic_icon_heart"
        android:background="@color/mau_nen_anh_den"
        app:layout_constraintEnd_toStartOf="@id/nut_bam_chitiet"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>